{
  "model_id": "model-1-s",
  "config_id": "config-00",
  "name": "MSFA / Faster R-CNN synthetic-v3",
  "backend": "faster",
  "input_size": [
    800,
    800
  ],
  "run": {
    "id": "fit",
    "output_root": "C.results/1.train"
  },
  "references": {
    "sardet_100k": "/workspace/SARdetect/D.codes/1.model/model1s-MSFA"
  },
  "data": {
    "root": "/workspace/SARdetect/A.dataset/SIVED_ATR_synthetic_v3/annotations",
    "train_annotations": "train.json",
    "val_annotations": "val.json",
    "test_annotations": "test.json",
    "image_prefix": "/workspace/SARdetect/A.dataset/SIVED_ATR_synthetic_v3/images/",
    "classes": [
      "vehicle"
    ],
    "flip_probability": 0.5,
    "sar_domain_randomization": {
      "enabled": true,
      "probability": 0.35,
      "gamma_range": [
        0.9,
        1.1
      ],
      "contrast_range": [
        0.9,
        1.1
      ],
      "gain_range": [
        0.95,
        1.05
      ],
      "speckle_std_range": [
        0.0,
        0.035
      ],
      "log_strength_range": [
        0.0,
        2.0
      ]
    }
  },
  "model": {
    "architecture": "faster_rcnn",
    "input_size": [
      800,
      800
    ],
    "feature_mode": "wavelet",
    "fpn_channels": 256,
    "anchor_scales": [
      8
    ],
    "anchor_ratios": [
      0.5,
      1.0,
      2.0
    ],
    "drop_path_rate": 0.4,
    "roi_bbox_loss_type": "L1Loss",
    "score_threshold": 0.001,
    "nms_iou_threshold": 0.8,
    "max_detections": 300,
    "pretrained_detector": "/workspace/SARdetect/B.models/model-1-s/SIVED_ATR_v3_stage14_best.pth"
  },
  "train": {
    "epochs": 6,
    "val_interval": 1,
    "batch_size": 2,
    "val_batch_size": 1,
    "test_batch_size": 1,
    "workers": 4,
    "learning_rate": 3e-05,
    "backbone_lr_multiplier": 0.2,
    "weight_decay": 0.05,
    "warmup_iters": 100,
    "milestones": [
      4,
      5
    ],
    "clip_grad_norm": 1.0,
    "accumulative_counts": 1,
    "amp": false,
    "log_interval": 50,
    "checkpoint_interval": 1,
    "max_keep_checkpoints": 2
  },
  "runtime": {
    "seed": 3922,
    "deterministic": false,
    "distributed_backend": "hccl",
    "world_size": 1,
    "physical_devices": "0"
  },
  "base_model_id": "model-1"
}
