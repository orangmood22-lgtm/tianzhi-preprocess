{
  "model_id": "model-3-s",
  "config_id": "config-00",
  "name": "RT-DETRv2 synthetic-v3",
  "backend": "rtdetr",
  "input_size": [
    1024,
    1024
  ],
  "run": {
    "id": "fit",
    "output_root": "C.results/1.train"
  },
  "references": {
    "rtdetrv2": "/workspace/SARdetect/D.codes/1.model/model3s-RT-DETRv2"
  },
  "data": {
    "root": "/workspace/SARdetect/A.dataset/SIVED_ATR_synthetic_v3/annotations",
    "train_annotations": "train.json",
    "val_annotations": "val.json",
    "test_annotations": "test.json",
    "image_prefix": "/workspace/SARdetect/A.dataset/SIVED_ATR_synthetic_v3/images/",
    "classes": [
      "vehicle"
    ],
    "flip_probability": 0.5,
    "multiscale_sizes": []
